{
  "name": "build-sprint-app",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit -p convex/tsconfig.json",
    "test:storage": "node tests/upload-integration.mjs",
    "predev": "node scripts/prepare-ocr.mjs",
    "prebuild": "node scripts/prepare-ocr.mjs",
    "test:ocr": "node scripts/prepare-ocr.mjs && node scripts/create-ocr-fixtures.mjs && node tests/ocr-integration.mjs",
    "setup:auth": "node scripts/setup-auth.mjs",
    "verify": "npm test && npm run check && npm audit --omit=dev",
    "predeploy": "npm run verify && node scripts/setup-auth.mjs --prod --site-url=https://zealous-kiwi-423.convex.site --skip-push",
    "deploy": "npx @convex-dev/static-hosting deploy",
    "test:vision": "node tests/vision-integration.mjs",
    "test:semen": "node scripts/prepare-ocr.mjs && node tests/semen-ocr-integration.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@convex-dev/auth": "^0.0.96",
    "@convex-dev/static-hosting": "^0.2.1",
    "@fontsource/manrope": "^5.3.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "convex": "^1.46.0",
    "heic-to": "^1.6.6",
    "jose": "^5.10.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@fontsource/public-sans": "^5.3.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.25.12",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^6.4.3"
  }
}
